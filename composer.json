{
    "name": "sekolah/presensi",
    "description": "Sistem Manajemen Presensi Sekolah - PHP Native MVC",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-mbstring": "*",
        "ext-gd": "*",
        "vlucas/phpdotenv": "^5.6",
        "endroid/qr-code": "^6.0",
        "phpoffice/phpspreadsheet": "^1.29",
        "dompdf/dompdf": "^3.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Helpers/functions.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
